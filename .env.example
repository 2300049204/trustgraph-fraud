# Client (safe to expose)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server only — never prefix with VITE_
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Lovable AI Gateway key for the Explainer / Planner / Reviewer agents.
# Optional: without it the app falls back to deterministic narratives.
LOVABLE_API_KEY=<ai-gateway-key>
